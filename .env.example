# ================= Geral =================
APP_NAME="JiuJitsu Cobrança Bot"
ACADEMY_NAME="Academia de Jiu-Jitsu"
ENVIRONMENT=development
DATABASE_URL=sqlite:///./jiujitsu_bot.db
TIMEZONE=America/Manaus

# Protege /api/* (envie no header X-API-Key). Gere algo longo e aleatório.
ADMIN_API_KEY=

# WhatsApp do professor/secretaria (DDI+DDD+número) para avisos de "falar com professor"
ADMIN_PHONE=
HANDOFF_HOURS=12

# ================= WhatsApp Cloud API (Meta) =================
# Token permanente de System User (Business Manager > Usuários do sistema)
WHATSAPP_TOKEN=
# WhatsApp > Configuração da API: "Identificação do número de telefone"
WHATSAPP_PHONE_NUMBER_ID=
# WhatsApp > Configuração da API: "Identificação da conta do WhatsApp Business"
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Texto que você inventa e repete no cadastro do webhook na Meta
WHATSAPP_VERIFY_TOKEN=troque_por_um_texto_secreto
# Configurações do app > Básico > Chave secreta do app
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR

WHATSAPP_TEMPLATE_DUE_SOON=mensalidade_lembrete_3dias
WHATSAPP_TEMPLATE_DUE_TODAY=mensalidade_vencimento_hoje
WHATSAPP_TEMPLATE_OVERDUE=mensalidade_em_atraso
WHATSAPP_TEMPLATE_PAYMENT_CONFIRMED=mensalidade_confirmada

# ================= Asaas =================
ASAAS_API_KEY=
ASAAS_ENVIRONMENT=sandbox
# Mesmo token configurado no cadastro do webhook no Asaas
ASAAS_WEBHOOK_TOKEN=

# ================= Régua de cobrança =================
BILLING_RUN_HOUR=8
BILLING_RUN_MINUTE=0
BILLING_ADVANCE_DAYS=5
